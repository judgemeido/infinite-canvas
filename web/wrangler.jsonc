{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "infinite-canvas",
    "main": "server/index.js",
    "compatibility_date": "2026-08-13",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
    }
}
